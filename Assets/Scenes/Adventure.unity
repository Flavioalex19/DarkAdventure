  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '... My back trembles, my throat is crushed, my legs feel heavy and my
    mind feels like it is at war. I feel like I don''t have an end to the tunnel,
    just a perpetual darkness. I don''t know what to do anymore, I don''t know what
    to think anymore. I just exist. Strength that I don''t know where to get from.
    I just think about getting up and going back to lay down. I pray to God every
    day, I feel that I''m not only losing a fight, but I feel that the tentacles
    of darkness pull me, pull me down, pull me to my prison. I broke, and I feel
    that I continue breaking. I don''t know what to write anymore, I don''t know
    what to do anymore. I just exist, for now.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e6dd5bbce28bcb3459fb3d17f3c198ba, type: 2}
